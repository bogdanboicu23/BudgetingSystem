@inherits LayoutComponentBase

<div class="min-h-screen bg-gray-50">
    <div class="flex">
        <div class="w-64 bg-white shadow-lg min-h-screen">
            <NavMenu />
        </div>

        <main class="flex-1">
            <article class="p-6">
                @Body
            </article>
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet class="fixed top-0 left-0 right-0 bg-red-600 text-white p-4 text-center z-50 hidden">
    An unhandled error has occurred.
    <a href="." class="underline ml-2">Reload</a>
    <span class="ml-4 cursor-pointer">🗙</span>
</div>
