    {
        plannedIncomes.RemoveAll(i => i.Id == itemId);
        plannedExpenses.RemoveAll(e => e.Id == itemId);
        StateHasChanged();
    }

    private decimal GetNetPlanned()
    {
        return plannedIncomes.Sum(i => i.PlannedAmount) - plannedExpenses.Sum(e => e.PlannedAmount);
    }

    private decimal GetNetActual()
    {
        return plannedIncomes.Sum(i => i.LinkedAmount) - plannedExpenses.Sum(e => e.LinkedAmount);
    }

    private decimal GetVariance()
    {
        return GetNetActual() - GetNetPlanned();
    }

