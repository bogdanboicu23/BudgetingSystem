    // Decorator Pattern Methods
    private async Task ToggleEnhancedView()
    {
        showEnhancedView = !showEnhancedView;
        if (showEnhancedView && enhancedBudgetData == null)
        {
            await LoadEnhancedData();
        }
    }

    private async Task LoadEnhancedData()
    {
        try
        {
            var performanceResponse = await Http.GetAsync($"/api/budgetanalytics/performance/{BudgetId}");
            var alertsResponse = await Http.GetAsync($"/api/budgetanalytics/alerts/{BudgetId}");

            if (performanceResponse.IsSuccessStatusCode && alertsResponse.IsSuccessStatusCode)
            {
                enhancedBudgetData = await performanceResponse.Content.ReadFromJsonAsync<EnhancedBudgetData>();
                budgetAlerts = await alertsResponse.Content.ReadFromJsonAsync<List<BudgetAlert>>() ?? new();
            }
            else
            {
                LoadMockEnhancedData();
            }
        }
        catch (Exception)
        {
            LoadMockEnhancedData();
        }
    }

    private void LoadMockEnhancedData()
    {
        enhancedBudgetData = new EnhancedBudgetData
        {
            BudgetId = BudgetId,
            TimeProgress = GetTimeProgress() / 100.0,
            SpendingProgress = (double)(currentBudget!.SpentAmount / currentBudget.Amount),
            EfficiencyRatio = 1.15,
            DailySpendingRate = 61.67,
            ProjectedEndAmount = 2450m,
            IsOnTrack = false
        };

        budgetAlerts = new List<BudgetAlert>
        {
            new BudgetAlert { Type = "Warning", Message = "Spending rate is 15% above planned", CreatedAt = DateTime.Now.AddMinutes(-10) },
            new BudgetAlert { Type = "Info", Message = "Budget is 74% through the period", CreatedAt = DateTime.Now.AddHours(-2) }
        };
    }

    private double GetTimeProgress()
    {
        if (currentBudget == null) return 0;
        var totalDays = (currentBudget.PeriodEnd - currentBudget.PeriodStart).TotalDays;
        var daysPassed = (DateTime.Now - currentBudget.PeriodStart).TotalDays;
        return Math.Min(100, Math.Max(0, (daysPassed / totalDays) * 100));
    }

    private string GetAlertClass(string type)
    {
        return type switch
        {
            "Critical" => "bg-red-50 border-red-200 text-red-800",
            "Warning" => "bg-yellow-50 border-yellow-200 text-yellow-800",
            _ => "bg-blue-50 border-blue-200 text-blue-800"
        };
    }

    // Enhanced DTOs
    public class EnhancedBudgetData
    {
        public Guid BudgetId { get; set; }
        public double TimeProgress { get; set; }
        public double SpendingProgress { get; set; }
        public double EfficiencyRatio { get; set; }
        public double DailySpendingRate { get; set; }
        public decimal ProjectedEndAmount { get; set; }
        public bool IsOnTrack { get; set; }
    }

    public class BudgetAlert
    {
        public string Type { get; set; } = "";
        public string Message { get; set; } = "";
        public DateTime CreatedAt { get; set; }
    }

    public class BudgetDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public DateTime PeriodStart { get; set; }
        public DateTime PeriodEnd { get; set; }
        public decimal Amount { get; set; }
        public decimal SpentAmount { get; set; }
        public decimal PlannedIncomeAmount { get; set; }
        public decimal ActualIncomeAmount { get; set; }
        public string Status { get; set; } = "";
    }

    public class PlannedItemDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal PlannedAmount { get; set; }
        public decimal LinkedAmount { get; set; }
        public string Category { get; set; } = "";
        public DateTime? DueDate { get; set; }
        public bool IsRecurring { get; set; }

        public decimal GetUtilizationPercentage()
        {
            return PlannedAmount == 0 ? 0 : (LinkedAmount / PlannedAmount) * 100;
        }

        public bool IsOverBudget()
        {
            return LinkedAmount > PlannedAmount;
        }

        public bool IsCompleted()
        {
            return Math.Abs(LinkedAmount - PlannedAmount) < 0.01m;
        }
    }
