@page "/design-patterns"
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Design Patterns Demo</PageTitle>

<div class="space-y-6">
    <div class="flex justify-between items-center">
        <h1 class="text-3xl font-bold text-gray-900">Design Patterns Implementation</h1>
        <span class="badge-success">4 Patterns Implemented</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Strategy Pattern Card -->
        <div class="bg-white rounded-xl shadow-soft border border-gray-100 p-6">
            <div class="flex items-center mb-4">
                <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mr-4">
                    <svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                </div>
                <div>
                    <h2 class="text-xl font-semibold text-gray-900">Strategy Pattern</h2>
                    <p class="text-gray-600">Budget calculation algorithms</p>
                </div>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Budget Strategy</label>
                    <select @bind="selectedStrategy" class="select-field">
                        <option value="fixed">Fixed Budget</option>
                        <option value="percentage">Percentage Based</option>
                        <option value="rolling">Rolling Budget</option>
                    </select>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Total Budget</label>
                        <input @bind="totalBudget" type="number" class="input-field" placeholder="5000" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Spent Amount</label>
                        <input @bind="spentAmount" type="number" class="input-field" placeholder="2650" />
                    </div>
                </div>

                <button @onclick="CalculateBudget" class="btn-primary w-full">
                    Calculate Available Amount
                </button>

                @if (!string.IsNullOrEmpty(strategyResult))
                {
                    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                        <p class="text-sm font-medium text-blue-800">Result:</p>
                        <p class="text-lg font-semibold text-blue-900">@strategyResult</p>
                    </div>
                }
            </div>
        </div>

        <!-- Observer Pattern Card -->
        <div class="bg-white rounded-xl shadow-soft border border-gray-100 p-6">
            <div class="flex items-center mb-4">
                <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mr-4">
                    <svg class="w-6 h-6 text-green-600" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                    </svg>
                </div>
                <div>
                    <h2 class="text-xl font-semibold text-gray-900">Observer Pattern</h2>
                    <p class="text-gray-600">Budget limit notifications</p>
                </div>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Notification Type</label>
                    <select @bind="notificationType" class="select-field">
                        <option value="email">Email Alert</option>
                        <option value="sms">SMS Alert</option>
                        <option value="push">Push Notification</option>
                    </select>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Budget Limit</label>
                        <input @bind="budgetLimit" type="number" class="input-field" placeholder="1000" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Current Amount</label>
                        <input @bind="currentAmount" type="number" class="input-field" placeholder="950" />
                    </div>
                </div>

                <button @onclick="TriggerNotification" class="btn-primary w-full">
                    Test Notification
                </button>

                @if (notifications.Any())
                {
                    <div class="space-y-2">
                        @foreach (var notification in notifications.Take(3))
                        {
                            <div class="bg-green-50 border border-green-200 rounded-lg p-3">
                                <p class="text-sm text-green-800">@notification</p>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Chain of Responsibility Pattern Card -->
        <div class="bg-white rounded-xl shadow-soft border border-gray-100 p-6">
            <div class="flex items-center mb-4">
                <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mr-4">
                    <svg class="w-6 h-6 text-purple-600" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M4 12l1.41 1.41L11 7.83V20h2V7.83l5.59 5.58L20 12l-8-8-8 8z"/>
                    </svg>
                </div>
                <div>
                    <h2 class="text-xl font-semibold text-gray-900">Chain of Responsibility</h2>
                    <p class="text-gray-600">Transaction processing pipeline</p>
                </div>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Transaction Type</label>
                    <select @bind="transactionType" class="select-field">
                        <option value="deposit">Bank Deposit</option>
                        <option value="withdrawal">Bank Withdrawal</option>
                        <option value="transfer">Bank Transfer</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Transaction Amount</label>
                    <input @bind="transactionAmount" type="number" class="input-field" placeholder="250" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                    <input @bind="transactionDescription" class="input-field" placeholder="Monthly salary" />
                </div>

                <button @onclick="ProcessTransaction" class="btn-primary w-full">
                    Process Transaction
                </button>

                @if (!string.IsNullOrEmpty(processingResult))
                {
                    <div class="bg-purple-50 border border-purple-200 rounded-lg p-4">
                        <p class="text-sm font-medium text-purple-800">Processing Result:</p>
                        <p class="text-sm text-purple-900">@processingResult</p>
                    </div>
                }
            </div>
        </div>

        <!-- Template Method Pattern Card -->
        <div class="bg-white rounded-xl shadow-soft border border-gray-100 p-6">
            <div class="flex items-center mb-4">
                <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center mr-4">
                    <svg class="w-6 h-6 text-orange-600" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 2 2h8c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-1 18H7v-1h6v1zm0-3H7v-1h6v1zm2-3H7V6h8v8z"/>
                    </svg>
                </div>
                <div>
                    <h2 class="text-xl font-semibold text-gray-900">Template Method</h2>
                    <p class="text-gray-600">Report generation system</p>
                </div>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Report Type</label>
                    <select @bind="reportType" class="select-field">
                        <option value="summary">Summary Report</option>
                        <option value="detailed">Detailed Report</option>
                        <option value="category">Category Breakdown</option>
                    </select>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Start Date</label>
                        <input @bind="startDate" type="date" class="input-field" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">End Date</label>
                        <input @bind="endDate" type="date" class="input-field" />
                    </div>
                </div>

                <button @onclick="GenerateReport" class="btn-primary w-full">
                    Generate Report
                </button>

                @if (!string.IsNullOrEmpty(reportResult))
                {
                    <div class="bg-orange-50 border border-orange-200 rounded-lg p-4">
                        <p class="text-sm font-medium text-orange-800">Report Generated:</p>
                        <p class="text-sm text-orange-900">@reportResult</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    // Strategy Pattern
    private string selectedStrategy = "fixed";
    private decimal totalBudget = 5000;
    private decimal spentAmount = 2650;
    private string strategyResult = "";

    // Observer Pattern
    private string notificationType = "email";
    private decimal budgetLimit = 1000;
    private decimal currentAmount = 950;
    private List<string> notifications = new();

    // Chain of Responsibility
    private string transactionType = "deposit";
    private decimal transactionAmount = 250;
    private string transactionDescription = "Monthly salary";
    private string processingResult = "";

    // Template Method
    private string reportType = "summary";
    private DateOnly startDate = DateOnly.FromDateTime(DateTime.Now.AddDays(-30));
    private DateOnly endDate = DateOnly.FromDateTime(DateTime.Now);
    private string reportResult = "";

    private async Task CalculateBudget()
    {
        try
        {
            var request = new
            {
                BudgetId = Guid.NewGuid(),
                StrategyType = selectedStrategy,
                TotalBudget = totalBudget,
                CurrentSpending = spentAmount
            };

            var response = await Http.PostAsJsonAsync("/api/budgets/calculate", request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<BudgetCalculationResult>();
                if (result != null)
                {
                    strategyResult = $"Strategy: {result.StrategyUsed} | Available: ${result.AvailableAmount:F2} | Spent: {result.SpentPercentage:F1}%";

                    if (result.Warnings?.Any() == true)
                    {
                        strategyResult += $" | Warnings: {string.Join(", ", result.Warnings)}";
                    }
                }
            }
            else
            {
                // Fallback to local calculation
                decimal availableAmount = selectedStrategy switch
                {
                    "fixed" => Math.Max(0, totalBudget - spentAmount),
                    "percentage" => totalBudget * 0.1m,
                    "rolling" => totalBudget * 0.8m,
                    _ => totalBudget - spentAmount
                };

                strategyResult = $"Strategy: {selectedStrategy.ToUpperInvariant()} (Local) | Available: ${availableAmount:F2}";
            }
        }
        catch (Exception ex)
        {
            strategyResult = $"Error: {ex.Message}";
        }
    }

    private async Task TriggerNotification()
    {
        try
        {
            if (currentAmount >= budgetLimit * 0.9m) // 90% threshold
            {
                var message = $"{notificationType.ToUpperInvariant()}: Budget limit alert! ${currentAmount:F2} / ${budgetLimit:F2}";
                notifications.Insert(0, message);

                // Keep only last 10 notifications
                if (notifications.Count > 10)
                    notifications = notifications.Take(10).ToList();
            }
            else
            {
                notifications.Insert(0, $"{notificationType.ToUpperInvariant()}: Budget is within safe limits.");
            }
        }
        catch (Exception ex)
        {
            notifications.Insert(0, $"Error: {ex.Message}");
        }
    }

    private async Task ProcessTransaction()
    {
        try
        {
            var request = new
            {
                Description = transactionDescription,
                Amount = transactionAmount,
                Date = DateTime.Now,
                MerchantName = "Demo Merchant",
                TransactionType = transactionType
            };

            var response = await Http.PostAsJsonAsync("/api/transactions/process-single", request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<TransactionProcessingResult>();
                if (result != null)
                {
                    processingResult = $"Transaction: {result.Transaction?.Description} | Amount: ${result.Transaction?.Amount:F2} | Category: {result.Result?.CategoryName} | Classification: {result.Result?.Classification} | Processed: {result.Result?.IsProcessed}";
                }
            }
            else
            {
                // Fallback to local simulation
                var handlers = new List<string>();

                if (transactionType == "deposit")
                {
                    handlers.Add("DepositValidationHandler");
                    handlers.Add("DepositProcessingHandler");
                }
                else if (transactionType == "withdrawal")
                {
                    handlers.Add("WithdrawalValidationHandler");
                    handlers.Add("BalanceCheckHandler");
                    handlers.Add("WithdrawalProcessingHandler");
                }
                else if (transactionType == "transfer")
                {
                    handlers.Add("TransferDetectionHandler");
                    handlers.Add("TransferValidationHandler");
                    handlers.Add("TransferProcessingHandler");
                }

                processingResult = $"Transaction processed through: {string.Join(" → ", handlers)}. Amount: ${transactionAmount:F2} (Local Simulation)";
            }
        }
        catch (Exception ex)
        {
            processingResult = $"Error: {ex.Message}";
        }
    }

    private async Task GenerateReport()
    {
        try
        {
            var steps = new List<string>
            {
                "Data collection",
                "Data validation",
                "Processing calculations",
                "Formatting output"
            };

            var reportName = reportType switch
            {
                "summary" => "Monthly Summary Report",
                "detailed" => "Detailed Transaction Report",
                "category" => "Category Breakdown Report",
                _ => "Unknown Report"
            };

            reportResult = $"{reportName} generated for {startDate} to {endDate}. Steps: {string.Join(" → ", steps)}";
        }
        catch (Exception ex)
        {
            reportResult = $"Error: {ex.Message}";
        }
    }

    // DTOs for API responses
    public class BudgetCalculationResult
    {
        public decimal AvailableAmount { get; set; }
        public decimal TotalBudget { get; set; }
        public decimal CurrentSpending { get; set; }
        public string StrategyUsed { get; set; } = "";
        public decimal SpentPercentage { get; set; }
        public List<string>? Warnings { get; set; }
    }

    public class TransactionProcessingResult
    {
        public TransactionDto? Transaction { get; set; }
        public ProcessingResultDto? Result { get; set; }
    }

    public class TransactionDto
    {
        public string Description { get; set; } = "";
        public decimal Amount { get; set; }
        public DateTime Date { get; set; }
        public string MerchantName { get; set; } = "";
        public string TransactionType { get; set; } = "";
    }

    public class ProcessingResultDto
    {
        public string CategoryName { get; set; } = "";
        public string Classification { get; set; } = "";
        public bool IsProcessed { get; set; }
        public string ProcessedBy { get; set; } = "";
    }
}